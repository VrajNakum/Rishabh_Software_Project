# Backend Server
SERVER_PORT=8080

# PostgreSQL Database (falls back to embedded H2 if PostgreSQL is unreachable)
DB_URL=jdbc:postgresql://localhost:5432/travel_management_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# JPA / Debug Flags (keep false in production)
DB_DDL_AUTO=validate
DB_SHOW_SQL=false
H2_CONSOLE_ENABLED=false

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Initial Demo Seed Data (set to true only for local empty-database bootstrapping)
APP_SEED_DEMO_DATA=false
APP_DEFAULT_USER_PASSWORD=change_me_before_use

# JWT Authentication (use a strong 32+ character secret in production)
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_characters_long
JWT_EXPIRATION_MS=86400000
